########################################################################
#                              .gitignore                              #
########################################################################
#  Author:            Kevin Street                                     #
#  Created on:        2026-10-14                                       #
#  Last modified on:  2026-10-29                                       #
#  Purpose:           Keeps secrets, keys, caches, builds, runtime     #
#                     logs and generated data out of git.              #
########################################################################
# Secrets and keys: never committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_*
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/

# Runtime logs: kds.logs writes <log_dir>/YYYY-MM-DD.jsonl
logs/
*.log
????-??-??.jsonl
# ...except the logs package, whose folders share the name
!/logs/
!/logs/kds/logs/

# Generated data and databases (regenerate with the scripts)
data/generated/
*.sqlite
*.db

# Editors and operating systems
.idea/
.vscode/
.DS_Store
