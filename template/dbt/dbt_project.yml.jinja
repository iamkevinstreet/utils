# Author:            Kevin Street
# Created on:        2026-11-09
# Last modified on:  2026-11-09
#
# The one dbt project: staging views over the raw tables dlt loads,
# intermediate views that line the sources up, and a published mart per
# domain, each a table with an enforced contract. The same models build
# in DuckDB (dev, CI) and Databricks (prod).

name: {{ repo | replace('-', '_') }}
version: "0.1.0"
config-version: 2
profile: warehouse

model-paths: ["models"]
seed-paths: ["seeds"]
test-paths: ["tests"]
macro-paths: ["macros"]
analysis-paths: ["analyses"]
clean-targets: ["target", "logs"]

# No usage data leaves the machine, and no version check calls out.
flags:
  send_anonymous_usage_stats: false
  version_check: false

models:
  {{ repo | replace('-', '_') }}:
    # One view per raw table: renamed, cast, nothing joined.
    staging:
      +schema: staging
      +materialized: view
    # The sources lined up to one grain, for the marts to share.
    intermediate:
      +schema: intermediate
      +materialized: view
    # Each published mart is a folder of its own beside these, named for its domain, set as a
    # table in the domain's schema and group, with +access: public and its contract enforced.

seeds:
  {{ repo | replace('-', '_') }}:
    +schema: reference

data_tests:
  {{ repo | replace('-', '_') }}:
    +severity: error
